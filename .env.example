# ---------------------------------------------------------------------------
# Is file ko copy karke `.env` banao (local development ke liye).
# Vercel pe deploy karte waqt ye saari values Project -> Settings ->
# Environment Variables me daalni hain (.env file deploy nahi hoti).
# ---------------------------------------------------------------------------

# ---- Django ----
# Naya key: python -c "from django.core.management.utils import get_random_secret_key as g;print(g())"
SECRET_KEY=replace-me-with-a-long-random-secret-key
DEBUG=False

# ---- Database (Neon / Supabase / Vercel Postgres) ----
DB_NAME=your_database
DB_USER=your_user
DB_PASSWORD=your_password
DB_HOST=your-host.region.aws.neon.tech
DB_PORT=5432
DB_SSLMODE=require
# DB_CONN_MAX_AGE=0
# DB_DISABLE_SERVER_SIDE_CURSORS=True

# ---- Optional: apna custom domain ----
# EXTRA_ALLOWED_HOSTS=myapp.com,www.myapp.com
# EXTRA_CSRF_TRUSTED_ORIGINS=https://myapp.com

# ---- Optional: WebSocket notifications har instance pe (Upstash Redis) ----
# REDIS_URL=rediss://default:password@host:6379

# ---- Optional: media uploads cloud storage pe (Supabase Storage / S3 / R2) ----
# AWS_STORAGE_BUCKET_NAME=my-bucket
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_S3_ENDPOINT_URL=https://xxxxxxxxxxxx.supabase.co/storage/v1/s3
# AWS_S3_REGION_NAME=ap-south-1
# AWS_S3_CUSTOM_DOMAIN=xxxxxxxxxxxx.supabase.co/storage/v1/object/public/my-bucket
